  "textClasses": {
    "title": { "fontSize": 16, "fontFace": "Segoe UI Semibold", "color": "#f8fafc" },
    "label": { "fontSize": 11, "fontFace": "Segoe UI", "color": "#94a3b8" },
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#f8fafc" }
